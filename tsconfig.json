{
  // Covers the supplied harness (spec/, scripts/) and the app itself (src/),
  // which is TypeScript too.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    // node runs src/ by stripping types, not compiling them, so syntax it
    // can't strip (parameter properties, enums) must fail here, not at boot.
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts", "spec", "scripts", "src"]
}
